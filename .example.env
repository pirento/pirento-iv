# All configuration inputs are kept in this .example.env file, as requested.
# The app loads this file directly; hosting environment values take precedence.
# Fill in your own credentials locally or in your hosting control panel.
# Keep the distributed template blank. Never publish a filled-in copy.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=venturecore_workspace

# Hosted deployments require NODE_ENV=production, HOST=0.0.0.0 and the exact HTTPS
# website origin. EJS pages and APIs share one server and one origin.
# For local development, leave PUBLIC_APP_URL empty or use http://localhost:3001.
PUBLIC_APP_URL=
# Optional reverse-proxy IP/CIDR allowlist, separated by commas. Leave empty for
# direct connections. Only list the actual proxies forwarding to this server.
# Do not use true, hop counts or wildcard ranges. See docs/DEPLOYMENT.md.
TRUST_PROXY=
# Provision the first administrator through server settings before opening signup.
# Use a real email you control and a unique password of at least 12 characters.
# Existing account passwords are never reset by these startup values. Remove
# both INITIAL_ADMIN_EMAIL and INITIAL_ADMIN_PASSWORD after the first owner login.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# Venturecore divisions: shared Razorpay defaults. First use TEST mode keys.
# Register /api/webhooks/razorpay/:organizationId with the webhook secret
# for the corresponding account; legacy /api/webhooks/razorpay remains available
# for the shared main account. Keep all values server-only. See docs/DEPLOYMENT.md.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Venturecore/workspace email defaults. Provider adapter: Resend. First verify a sender/domain with the provider.
# These are not Hostinger SMTP credentials. Hostinger email can be used as your
# business mailbox; this delivery adapter sends through Resend's HTTP API.
EMAIL_FROM=
RESEND_API_KEY=
# Enable automatic invoice/receipt/failure emails only after sender verification.
# Manual send still requires a configured sender. Old held messages are not
# automatically released when this setting or credentials change.
# Payment reminders have a separate off-by-default policy in the workspace UI.
# This flag does not enable reminders or recurring invoice schedules.
EMAIL_AUTOMATION=false

# Shri Sarraf is an independent business. These settings NEVER inherit the
# shared Razorpay/Resend values above, including automatic-email activation.
# Cashfree uses its client secret to verify signed webhooks; no Razorpay webhook
# secret is used. Register /api/webhooks/cashfree/shri-sarraf in its Cashfree account.
SHRI_SARRAF_CASHFREE_CLIENT_ID=
SHRI_SARRAF_CASHFREE_CLIENT_SECRET=
# Leave sandbox until the hosted test flow is verified. Live value: production.
SHRI_SARRAF_CASHFREE_ENVIRONMENT=sandbox
SHRI_SARRAF_EMAIL_FROM=
SHRI_SARRAF_RESEND_API_KEY=
SHRI_SARRAF_EMAIL_AUTOMATION=false

# Optional per-division overrides: replace PIRENTO_LEGAL with one of
# PIRENTO_ECOSYSTEM, AT_FACILITY, A_T_ELEVATOR or INZARIO_SPACE.
# New organization prefixes are shown in its Payments & email screen.
# Supplying ANY variable in a credential group disables shared fallback for
# the WHOLE group, even if its value is blank. Set the complete group together.
# PIRENTO_LEGAL_RAZORPAY_KEY_ID=
# PIRENTO_LEGAL_RAZORPAY_KEY_SECRET=
# PIRENTO_LEGAL_RAZORPAY_WEBHOOK_SECRET=
# PIRENTO_LEGAL_EMAIL_FROM=
# PIRENTO_LEGAL_RESEND_API_KEY=
# PIRENTO_LEGAL_EMAIL_AUTOMATION=false
# Cashfree, if chosen for another business, uses its own complete prefixed pair:
# PIRENTO_LEGAL_CASHFREE_CLIENT_ID=
# PIRENTO_LEGAL_CASHFREE_CLIENT_SECRET=
# PIRENTO_LEGAL_CASHFREE_ENVIRONMENT=sandbox

# Support addresses are editable organization data, not verified EMAIL_FROM
# senders: support@pirento.com for Venturecore divisions and
# support@shrisarraf.com for Shri Sarraf. Verify outgoing senders separately.

# Sandbox GST Search API. Use test credentials first; test responses are examples,
# not verification of a real customer's registration. Keep keys on the server.
# Set GST_PROVIDER=sandbox to use Sandbox instead of the public portal.
# SANDBOX_ENVIRONMENT accepts test or production. Use matching credentials.
GST_PROVIDER=
SANDBOX_ENVIRONMENT=test
SANDBOX_API_KEY=
SANDBOX_API_SECRET=

# Verified MongoDB Extended JSON snapshots: private storage outside public assets.
# The schedule starts with the Node server. Local snapshots are not offsite backups.
BACKUP_ENABLED=false
DATABASE_BACKUP_DIR=
BACKUP_INTERVAL_MINUTES=1440
BACKUP_RETENTION_COUNT=7

# Without an explicit provider or provider URL, the app offers public portal lookup with a human-entered
# CAPTCHA. This requires network access to services.gst.gov.in; no CAPTCHA is bypassed.
# Optional GST provider integration; the endpoint must be HTTPS.
# The server substitutes the validated GSTIN for {gstin}.
# Expected JSON: { "gstin": "…", "name": "…", "address": "…", "stateCode": "27", "status": "Active" }
# A { "data": { ... } } wrapper is also accepted. status is optional.
# Adapt your provider's response to this contract before configuring its URL.
# No taxpayer data is fabricated when the provider is absent or unavailable.
GST_LOOKUP_URL=
# Sent as Authorization: Bearer <key>. Leave blank for endpoints without bearer auth.
GST_API_KEY=

# Optional shared Cashfree defaults for Venturecore divisions that select Cashfree.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox

# Optional complete per-business overrides. Keep lines commented to inherit the
# shared division credentials. Uncomment and fill a complete credential group
# only when that business should use a different merchant account or email sender.

# PIRENTO_ECOSYSTEM
# PIRENTO_ECOSYSTEM_RAZORPAY_KEY_ID=
# PIRENTO_ECOSYSTEM_RAZORPAY_KEY_SECRET=
# PIRENTO_ECOSYSTEM_RAZORPAY_WEBHOOK_SECRET=
# PIRENTO_ECOSYSTEM_CASHFREE_CLIENT_ID=
# PIRENTO_ECOSYSTEM_CASHFREE_CLIENT_SECRET=
# PIRENTO_ECOSYSTEM_EMAIL_FROM=
# PIRENTO_ECOSYSTEM_RESEND_API_KEY=
# PIRENTO_ECOSYSTEM_CASHFREE_ENVIRONMENT=sandbox
# PIRENTO_ECOSYSTEM_EMAIL_AUTOMATION=false

# AT_FACILITY
# AT_FACILITY_RAZORPAY_KEY_ID=
# AT_FACILITY_RAZORPAY_KEY_SECRET=
# AT_FACILITY_RAZORPAY_WEBHOOK_SECRET=
# AT_FACILITY_CASHFREE_CLIENT_ID=
# AT_FACILITY_CASHFREE_CLIENT_SECRET=
# AT_FACILITY_EMAIL_FROM=
# AT_FACILITY_RESEND_API_KEY=
# AT_FACILITY_CASHFREE_ENVIRONMENT=sandbox
# AT_FACILITY_EMAIL_AUTOMATION=false

# A_T_ELEVATOR
# A_T_ELEVATOR_RAZORPAY_KEY_ID=
# A_T_ELEVATOR_RAZORPAY_KEY_SECRET=
# A_T_ELEVATOR_RAZORPAY_WEBHOOK_SECRET=
# A_T_ELEVATOR_CASHFREE_CLIENT_ID=
# A_T_ELEVATOR_CASHFREE_CLIENT_SECRET=
# A_T_ELEVATOR_EMAIL_FROM=
# A_T_ELEVATOR_RESEND_API_KEY=
# A_T_ELEVATOR_CASHFREE_ENVIRONMENT=sandbox
# A_T_ELEVATOR_EMAIL_AUTOMATION=false

# INZARIO_SPACE
# INZARIO_SPACE_RAZORPAY_KEY_ID=
# INZARIO_SPACE_RAZORPAY_KEY_SECRET=
# INZARIO_SPACE_RAZORPAY_WEBHOOK_SECRET=
# INZARIO_SPACE_CASHFREE_CLIENT_ID=
# INZARIO_SPACE_CASHFREE_CLIENT_SECRET=
# INZARIO_SPACE_EMAIL_FROM=
# INZARIO_SPACE_RESEND_API_KEY=
# INZARIO_SPACE_CASHFREE_ENVIRONMENT=sandbox
# INZARIO_SPACE_EMAIL_AUTOMATION=false

# Optional test database URI. Use a separate disposable replica set/database.
# MONGODB_TEST_URI=

# Two-step login. TWO_STEP_KEY encrypts the authenticator keys stored in the database and
# is required in production: 64 hexadecimal characters, for example the output of
# `openssl rand -hex 32`. Keep it private and never change it afterwards; a new key
# turns off everyone's codes until an administrator removes and they set it up again.
TWO_STEP_KEY=
# Administrators must use two-step login in production. Set optional to let them choose.
ADMIN_TWO_STEP=

# Hosted entry guard. For an intentional FIRST hosted launch into a new database,
# set true, start successfully, then remove/disable it. Normal local npm start
# initializes a new database without this hosted guard.
IV_ALLOW_NEW_DATABASE=false

# Optional original disposable synthetic preview. Use a dedicated test MongoDB
# server/account. This launcher ignores normal database, admin and provider keys.
# Set IV_PREVIEW_MODE=disposable-synthetic only with start:synthetic-preview.
# NODE_ENV=production and an exact HTTPS PUBLIC_APP_URL are required.
# A fresh random preview database is created on each run and removed on clean exit.
IV_PREVIEW_MODE=
IV_PREVIEW_MONGODB_URI=
IV_PREVIEW_ADMIN_EMAIL=
IV_PREVIEW_ADMIN_NAME=
IV_PREVIEW_ADMIN_PASSWORD=

# Optional verification only. Use a dedicated test replica set, never a live business database.
# Test fixtures create and remove their own randomly named databases.
MONGODB_TEST_URI=
# Optional existing Chromium/headless-shell executable; normally use npm run test:browser:install.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
