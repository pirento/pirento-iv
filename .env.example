# Local defaults. Copy to .env; never commit .env or real credentials.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=.data/workspace.sqlite

# Hosted deployments require NODE_ENV=production, HOST=0.0.0.0 and the exact HTTPS
# website origin. During local Vite development leave PUBLIC_APP_URL empty, or
# set it to the browser's frontend origin (not the API proxy target).
PUBLIC_APP_URL=
# Provision the first administrator through server settings before opening signup.
# Use a real email you control and a unique password of at least 12 characters.
# Existing account passwords are never reset by these startup values. Remove
# both INITIAL_ADMIN_EMAIL and INITIAL_ADMIN_PASSWORD after the first owner login.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# Venturecore divisions: shared Razorpay defaults. First use TEST mode keys.
# Register /api/webhooks/razorpay/:organizationId with the webhook secret
# for the corresponding account; legacy /api/webhooks/razorpay remains available
# for the shared main account. Keep all values server-only. See PLATFORM_SETUP.md.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Venturecore/workspace email defaults. Provider adapter: Resend. First verify a sender/domain with the provider.
# These are not Hostinger SMTP credentials. Hostinger email can be used as your
# business mailbox; this delivery adapter sends through Resend's HTTP API.
EMAIL_FROM=
RESEND_API_KEY=
# Enable automatic invoice/receipt/failure emails only after sender verification.
# Manual send still requires a configured sender. Old held messages are not
# automatically released when this setting or credentials change.
EMAIL_AUTOMATION=false

# Shri Sarraf is an independent business. These settings NEVER inherit the
# shared Razorpay/Resend values above, including automatic-email activation.
# Cashfree uses its client secret to verify signed webhooks; no Razorpay webhook
# secret is used. Register /api/webhooks/cashfree/shri-sarraf in its Cashfree account.
SHRI_SARRAF_CASHFREE_CLIENT_ID=
SHRI_SARRAF_CASHFREE_CLIENT_SECRET=
# Leave sandbox until the hosted test flow is verified. Live value: production.
SHRI_SARRAF_CASHFREE_ENVIRONMENT=sandbox
SHRI_SARRAF_EMAIL_FROM=
SHRI_SARRAF_RESEND_API_KEY=
SHRI_SARRAF_EMAIL_AUTOMATION=false

# Optional per-division overrides: replace PIRENTO_LEGAL with one of
# PIRENTO_ECOSYSTEM, AT_FACILITY, A_T_ELEVATOR or INZARIO_SPACE.
# New organization prefixes are shown in its Payments & email screen.
# Supplying ANY variable in a credential group disables shared fallback for
# the WHOLE group, even if its value is blank. Set the complete group together.
# PIRENTO_LEGAL_RAZORPAY_KEY_ID=
# PIRENTO_LEGAL_RAZORPAY_KEY_SECRET=
# PIRENTO_LEGAL_RAZORPAY_WEBHOOK_SECRET=
# PIRENTO_LEGAL_EMAIL_FROM=
# PIRENTO_LEGAL_RESEND_API_KEY=
# PIRENTO_LEGAL_EMAIL_AUTOMATION=false
# Cashfree, if chosen for another business, uses its own complete prefixed pair:
# PIRENTO_LEGAL_CASHFREE_CLIENT_ID=
# PIRENTO_LEGAL_CASHFREE_CLIENT_SECRET=
# PIRENTO_LEGAL_CASHFREE_ENVIRONMENT=sandbox

# Support addresses are editable organization data, not verified EMAIL_FROM
# senders: support@pirento.com for Venturecore divisions and
# support@shrisarraf.com for Shri Sarraf. Verify outgoing senders separately.

# Sandbox GST Search API. Use test credentials first; test responses are examples,
# not verification of a real customer's registration. No key belongs in VITE_ settings.
# Set GST_PROVIDER=sandbox to use Sandbox instead of the public portal.
# SANDBOX_ENVIRONMENT accepts test or production. Use matching credentials.
GST_PROVIDER=
SANDBOX_ENVIRONMENT=test
SANDBOX_API_KEY=
SANDBOX_API_SECRET=

# Verified SQLite snapshots: persistent private storage outside public assets.
# The schedule starts with the Node server. Local snapshots are not offsite backups.
BACKUP_ENABLED=false
DATABASE_BACKUP_DIR=
BACKUP_INTERVAL_MINUTES=1440
BACKUP_RETENTION_COUNT=7

# Without an explicit provider or provider URL, the app offers public portal lookup with a human-entered
# CAPTCHA. This requires network access to services.gst.gov.in; no CAPTCHA is bypassed.
# Optional GST provider integration; the endpoint must be HTTPS.
# The server substitutes the validated GSTIN for {gstin}.
# Expected JSON: { "gstin": "…", "name": "…", "address": "…", "stateCode": "27", "status": "Active" }
# A { "data": { ... } } wrapper is also accepted. status is optional.
# Adapt your provider's response to this contract before configuring its URL.
# No taxpayer data is fabricated when the provider is absent or unavailable.
GST_LOOKUP_URL=
# Sent as Authorization: Bearer <key>. Leave blank for endpoints without bearer auth.
GST_API_KEY=
