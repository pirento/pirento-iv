<%# Confirmation dialog for signing out sessions (used by the sessions and team pages). -%>
<dialog class="security-dialog" data-session-dialog aria-labelledby="session-confirm-title">
  <h2 id="session-confirm-title" data-session-title>Sign out a session</h2>
  <form data-session-confirm>
    <div data-error class="mg-message error" role="alert" tabindex="-1" hidden></div>
    <p data-session-description></p>
    <p class="security-muted" data-session-effect></p>
    <div class="security-dialog-actions">
      <button class="button" type="button" data-session-cancel autofocus>Cancel</button>
      <button class="button danger" type="submit" data-session-submit>Sign out</button>
    </div>
  </form>
</dialog>
