<%
const result = data.securitySessions;
const page = result.pagination;
const listUrl = pageNumber => helpers.pageUrl(data, 'sessions', { page: pageNumber });
%>
<div class="mg-page security-page" id="sessions-page">
  <header class="mg-intro">
    <div>
      <span class="mg-eyebrow">YOUR ACCOUNT</span>
      <h1>My sessions</h1>
      <p>Review your active sign-ins and end sessions you no longer need. These sessions belong to your account across every business in this workspace.</p>
    </div>
    <a class="button" href="<%= listUrl(page.page) %>">Refresh</a>
  </header>
  <section class="mg-card security-summary" aria-label="Session overview">
    <div>
      <strong data-session-total><%= result.total %></strong>
      <span><%= result.total === 1 ? 'active session' : 'active sessions' %></span>
      <small>Checked <%= helpers.displayDateTime(result.asOf) %> IST</small>
    </div>
    <button class="button" type="button" data-sessions-revoke-others <%= result.total > 1 ? '' : 'disabled' %>>Sign out other sessions</button>
  </section>
  <p class="security-muted">Session times are shown in Indian Standard Time (IST). A session ends when you sign out or when its expiry time is reached.</p>
  <div class="security-session-list" data-session-list>
    <% for (const session of result.sessions) { %>
      <article class="mg-card security-session" data-session-id="<%= session.id %>">
        <header>
          <h2><%= session.current ? 'This session' : 'Other session' %></h2>
          <% if (session.current) { %><span class="mg-badge" data-session-current>Current</span><% } %>
        </header>
        <dl>
          <dt>Signed in</dt>
          <dd><%= helpers.displayDateTime(session.createdAt) %> IST</dd>
          <dt>Expires</dt>
          <dd><%= helpers.displayDateTime(session.expiresAt) %> IST</dd>
        </dl>
        <button class="button" type="button" data-session-revoke="<%= session.id %>" <%= session.id ? '' : 'disabled' %>><%= session.current ? 'Sign out this session' : 'Sign out session' %></button>
        <% if (!session.id) { %>
          <p class="security-muted"><%= session.current ? 'Use the workspace Sign out button to end this session.' : 'Use Sign out other sessions to end this session.' %></p>
        <% } %>
      </article>
    <% } %>
  </div>
  <% if (!result.sessions.length) { %>
    <section class="mg-empty">
      <h2>No sessions on this page</h2>
      <p>Sessions may have ended since this page was opened. Refresh to check the current list.</p>
      <a class="button" href="<%= listUrl(1) %>">Open first page</a>
    </section>
  <% } %>
  <%- include('../partials/finance-pagination', {
    pagination: page,
    label: 'Active session pages',
    previousUrl: page.page > 1 ? listUrl(page.page - 1) : '',
    nextUrl: page.page < page.pageCount ? listUrl(page.page + 1) : ''
  }) %>
  <p class="security-muted">If you do not recognise a session, sign it out and reset your password. Signing out prevents future requests from that session; work already accepted may finish.</p>
  <%- include('session-confirmation') %>
</div>
<script type="module" src="/js/security/sessions.js"></script>
