<section class="auth-layout">
  <aside class="auth-story">
    <a class="auth-brand" href="/"
      ><span class="brand-mark">V</span><span>VENTURECORE<small>BUSINESS WORKSPACE</small></span></a
    >
    <div>
      <span class="eyebrow">ONE WORKSPACE. EVERY BUSINESS.</span>
      <h1>A clearer view<br />of your business.</h1>
      <p>
        Bring invoices, quotations, customers and payments together. Keep every business organized, with the
        right access for your team.
      </p>
      <div class="auth-features">
        <span>Invoicing &amp; collections</span><span>Business management</span><span>Team access</span>
      </div>
    </div>
    <small>Venturecore Solutions Private Limited</small>
  </aside>
  <div class="auth-panel">
    <div class="auth-form-wrap">
      <span class="eyebrow">YOUR WORKSPACE</span>
      <h2><%= data.pageTitle %></h2>
      <p class="muted"><%= ({ login: 'Enter your account details to continue.', signup: 'Request access. An administrator will review and activate your account.', 'forgot-password': 'Enter your account email to request a password reset link.', 'reset-password': 'Choose a new password for your account.' })[data.authView] %></p>
      <form id="auth-form" class="stack" data-mode="<%= data.authView %>">
        <div class="alert alert-error" data-form-error hidden role="alert"></div>
        <div class="alert alert-success" data-auth-success hidden role="status"></div>
        <% if (data.authView === 'signup') { %><label class="field"
          >Full name<input name="name" autocomplete="name" maxlength="120" required /></label
        ><label class="field"
          >Company <span class="optional">(optional)</span
          ><input name="company" autocomplete="organization" maxlength="160" /></label
        ><% } %> <% if (data.authView !== 'reset-password') { %><label class="field"
          >Email address<input
            type="email"
            name="email"
            autocomplete="email"
            maxlength="254"
            required /></label
        ><% } %> <% if (data.authView !== 'forgot-password') { %>
        <label class="field"
          >Password
          <div class="password-field">
            <input
              type="password"
              name="password"
              autocomplete="<%= data.authView === 'login' ? 'current-password' : 'new-password' %>"
              minlength="<%= data.authView === 'login' ? 1 : 12 %>"
              maxlength="256"
              required
            /><button class="text-button" type="button" data-password-toggle aria-label="Show password">
              Show
            </button>
          </div>
          <% if (data.authView !== 'login') { %><small>Use at least 12 characters.</small><% } %></label
        >
        <% if (data.authView !== 'login') { %><label class="field"
          >Confirm password<input
            type="password"
            name="confirmPassword"
            autocomplete="new-password"
            minlength="12"
            maxlength="256"
            required /></label
        ><% } %> <% } %> <% if (data.authView === 'login') { %>
        <div class="auth-options"><a href="/forgot-password">Forgot password?</a></div>
        <% } %>
        <button class="button button-primary button-full" type="submit">
          <%= ({login:'Sign in',signup:'Request access','forgot-password':'Send reset link','reset-password':'Update password'})[data.authView] %><span aria-hidden="true">→</span>
        </button>
      </form>
      <div class="auth-bottom">
        <% if (data.authView === 'login') { %>New to the workspace?
        <a href="/signup">Request an account</a><% } else { %><a href="/login">Back to sign in</a
        ><% } %>
      </div>
    </div>
  </div>
</section>
<script type="module" src="/js/auth/auth.js"></script>
