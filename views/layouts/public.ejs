<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <% if (typeof syntheticPreview !== 'undefined' && syntheticPreview) { %>
    <meta name="iv-deployment-mode" content="disposable-synthetic-preview" />
    <% } %>
    <title><%= data.pageTitle %> · Venturecore</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body class="public-page">
    <%- include('../partials/preview-notice') %>
    <main><%- include('../' + bodyView, { data, helpers }) %></main>
    <div id="toast-region" class="toast-region" aria-live="polite"></div>
    <script id="page-data" type="application/json"><%- helpers.json(data) %></script>
    <script type="module" src="/js/core/shell.js"></script>
  </body>
</html>
