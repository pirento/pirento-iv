{
  "name": "venturecore-workspace-mvc",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "Venturecore workspace — Express MVC, EJS, JavaScript and MongoDB",
  "engines": {
    "node": ">=24.5.0 <27"
  },
  "scripts": {
    "start": "node --use-env-proxy server.js",
    "start:hostinger": "node --use-env-proxy scripts/hostinger-entry.js",
    "dev": "node --use-env-proxy --watch server.js",
    "build": "node scripts/check.js",
    "check": "node scripts/check.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:integration": "node scripts/run-integration-tests.js",
    "db:backup": "node scripts/database.js backup",
    "db:restore": "node scripts/database.js restore",
    "db:resume": "node scripts/database.js resume",
    "db:import-sqlite": "node scripts/import-sqlite.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:synthetic-preview": "node --use-env-proxy scripts/synthetic-preview.js",
    "check:deployment": "node --use-env-proxy scripts/check-deployment.js",
    "package:preview": "npm run check && node scripts/package-preview.js",
    "package:synthetic-preview": "npm run check && node scripts/package-preview.js --synthetic",
    "audit:readiness": "node scripts/readiness-audit.js",
    "test:integration:optional": "node scripts/run-integration-tests.js --optional",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "verify:release": "npm run check && npm test && npm run test:integration && npm run test:browser && npm run audit:readiness",
    "verify:local": "node scripts/with-test-database.js -- npm run verify:release"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "dotenv": "^17.2.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "mongodb": "^7.0.0",
    "pdfmake": "^0.2.23",
    "sharp": "^0.35.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "prettier": "3.9.9"
  }
}
